#!/bin/sh
set -eu

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

(
  cd "$repo_root/worker"
  uv sync --frozen
  uv run pytest -q
  uv run python -m compileall -q app tests
  uvx --from pip-audit pip-audit --path .venv/lib/python3.13/site-packages
  uvx bandit -q -r app
)

derived_data="$(mktemp -d "${TMPDIR:-/tmp}/openbard-derived-data.XXXXXX")"
trap 'rm -rf "$derived_data"' EXIT HUP INT TERM

xcodebuild \
  -project "$repo_root/ios/OpenBard/OpenBard.xcodeproj" \
  -scheme OpenBard \
  -destination 'generic/platform=iOS' \
  -derivedDataPath "$derived_data" \
  CODE_SIGNING_ALLOWED=NO \
  build-for-testing
