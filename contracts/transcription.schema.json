{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://openbard.local/schemas/transcription.schema.json",
  "title": "openBard Transcription Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "engine_version",
    "note_events"
  ],
  "properties": {
    "engine": {
      "type": "string",
      "enum": ["dsp_v0", "ml_baseline", "basic_pitch"]
    },
    "engine_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tempo_bpm": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "key_guess": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "note_events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/note_event"
      }
    }
  },
  "definitions": {
    "note_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pitch_midi",
        "onset_seconds",
        "duration_seconds",
        "velocity",
        "confidence",
        "staff_hint"
      ],
      "properties": {
        "pitch_midi": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "onset_seconds": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "velocity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "onset_uncertainty_seconds": {
          "type": "number",
          "minimum": 0
        },
        "staff_hint": {
          "type": "string",
          "enum": ["treble", "bass", "unknown"]
        }
      }
    }
  }
}
